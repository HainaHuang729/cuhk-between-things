<view class="page">
  <view class="top-title">{{isEdit ? '编辑商品' : '发布商品'}}</view>
  <view wx:if="{{unavailableReason}}" class="unavailable">
    <view class="muted">{{unavailableReason}}</view>
    <view class="secondary-button" bindtap="goHome">返回首页</view>
  </view>
  <form wx:else class="form" bindsubmit="submit">
    <input class="field" name="title" value="{{form.title}}" data-field="title" bindinput="onFieldInput" disabled="{{submitting}}" maxlength="120" placeholder="标题，例如 Dell 27寸显示器" />
    <input class="field" name="price" value="{{form.price}}" data-field="price" bindinput="onFieldInput" disabled="{{submitting}}" type="digit" maxlength="15" placeholder="价格 元，只填数字" />
    <picker mode="selector" value="{{categoryIndex}}" range="{{categories}}" range-key="label" bindchange="onCategoryChange" disabled="{{submitting}}">
      <view class="field">{{categoryLabel}}</view>
    </picker>
    <picker mode="selector" value="{{conditionIndex}}" range="{{conditions}}" range-key="label" bindchange="onConditionChange" disabled="{{submitting}}">
      <view class="field">{{conditionLabel}}</view>
    </picker>
    <input class="field" name="handover_location" value="{{form.handover_location}}" data-field="handover_location" bindinput="onFieldInput" disabled="{{submitting}}" placeholder="地点，例如 56座 / 大学站" />
    <textarea class="field textarea" name="description" value="{{form.description}}" data-field="description" bindinput="onFieldInput" disabled="{{submitting}}" maxlength="2000" placeholder="描述" />
    <view class="upload-row" wx:if="{{images.length}}">
      <view wx:for="{{images}}" wx:key="*this" class="upload-item">
        <image class="upload-preview" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"></image>
        <button class="upload-remove" aria-label="删除图片" data-index="{{index}}" catchtap="removeImage" disabled="{{submitting || selectingImages}}">×</button>
      </view>
    </view>
    <button class="secondary-button" bindtap="chooseImages" loading="{{selectingImages}}" disabled="{{submitting || selectingImages}}">上传图片 {{images.length}}/9</button>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting || selectingImages}}" form-type="submit">{{isEdit ? '保存' : '提交'}}</button>
  </form>
</view>

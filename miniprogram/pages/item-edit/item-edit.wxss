.form > .primary-button,
.form > .secondary-button {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
}

.unavailable {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 40rpx;
}

.upload-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.upload-item {
  position: relative;
  min-width: 0;
}

.upload-preview {
  display: block;
  width: 100%;
  height: 208rpx;
  border-radius: 14rpx;
  background: #eee9f5;
}

.upload-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(31, 41, 51, 0.8);
  color: #ffffff;
  font-size: 36rpx;
  line-height: 1;
}

.form .field {
  width: 100%;
  box-sizing: border-box;
}

.form input.field {
  height: 88rpx;
  padding: 0 20rpx;
}

.field-group {
  min-width: 0;
}

.field-invalid {
  border-color: #b42318;
}

.field-error {
  margin-top: 8rpx;
  color: #b42318;
  font-size: 24rpx;
  line-height: 34rpx;
}
.form-actions {
  display: flex;
  gap: 16rpx;
}

.form-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 16rpx;
  font-size: 30rpx;
}

.form-actions .draft-button {
  flex: 0 0 200rpx;
}

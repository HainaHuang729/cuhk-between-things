<view class="page">
  <view class="top-title">发起拼团</view>
  <form class="form" bindsubmit="submit">
    <input class="field" name="title" maxlength="80" disabled="{{submitting}}" placeholder="标题（必填）" />
    <input class="field" name="source_platform" maxlength="40" disabled="{{submitting}}" placeholder="来源，例如 Costco、IKEA" />
    <input class="field" name="target_size" type="number" maxlength="2" disabled="{{submitting}}" placeholder="目标人数，含团长（2至50人）" />
    <input class="field" name="total_price" type="digit" maxlength="15" disabled="{{submitting}}" placeholder="总价 元（必填）" />
    <view class="deadline-row">
      <picker mode="date" value="{{date}}" start="{{minDate}}" disabled="{{submitting}}" bindchange="onDateChange"><view class="field">{{date}}</view></picker>
      <picker mode="time" value="{{time}}" disabled="{{submitting}}" bindchange="onTimeChange"><view class="field">{{time}} 截止</view></picker>
    </view>
    <input class="field" name="handover_location" maxlength="100" disabled="{{submitting}}" placeholder="交收地点（必填）" />
    <textarea class="field textarea" name="description" maxlength="2000" disabled="{{submitting}}" placeholder="规格、分摊方式、到货时间" />
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" form-type="submit">发起拼团</button>
  </form>
</view>

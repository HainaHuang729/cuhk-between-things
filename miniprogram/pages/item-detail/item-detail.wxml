<view class="page">
  <view wx:if="{{error}}" class="missing-item"><view class="muted">{{error}}</view><button class="secondary-button" bindtap="retryLoad">重试</button></view>
  <view wx:elif="{{loading && !item.id}}" class="muted">加载中</view>
  <view wx:elif="{{missing}}" class="missing-item">
    <view class="card-title">商品已删除或不存在</view>
    <view class="secondary-button" bindtap="goHome">返回首页</view>
  </view>
  <block wx:elif="{{item.id}}">
  <view class="detail-image">
    <swiper wx:if="{{gallery.length}}" class="detail-gallery" current="{{currentImage}}" bindchange="onGalleryChange">
      <swiper-item wx:for="{{gallery}}" wx:key="index">
        <view class="gallery-slide" data-index="{{index}}" bindtap="previewImages">
          <image wx:if="{{!item.failed}}" src="{{item.url}}" mode="aspectFit" data-index="{{index}}" data-url="{{item.url}}" binderror="onImageError"></image>
          <view wx:else class="detail-image-fallback">图片加载失败</view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="detail-image-fallback">暂无图片</view>
    <view wx:if="{{gallery.length > 1}}" class="gallery-count">{{currentImage + 1}} / {{gallery.length}}</view>
  </view>

  <view class="card">
    <view class="detail-title-row">
      <view class="card-title">{{item.title}}</view>
      <view class="detail-status status-{{item.status}}">{{item.status_label}}</view>
    </view>
    <view class="price">{{item.price}}元</view>
    <view class="seller-line">发布者 {{item.seller_name}}</view>
    <view class="muted">{{item.category_label}} · {{item.condition_label}} · {{item.dormitory}}</view>
    <view class="muted">{{item.handover_location}}</view>
  </view>

  <view class="detail-actions-row">
    <view
      class="favorite-button {{item.is_favorited ? 'favorited' : ''}}"
      bindtap="toggleFavorite"
    >{{item.is_favorited ? '已收藏' : '收藏'}}</view>
  </view>

  <view class="card">
    <view class="section-title">描述</view>
    <view>{{item.description}}</view>
  </view>

  <view wx:if="{{isOwner}}" class="owner-actions">
    <view class="secondary-button" bindtap="editItem">编辑商品</view>
    <view class="secondary-button" bindtap="manageStatus">修改状态</view>
    <view class="danger-button" bindtap="removeItem">删除</view>
  </view>

  <view class="card contact-panel">
    <view class="section-title">联系卖家</view>
    <view wx:if="{{canViewContact && contact.wechat_id}}">
      <view class="muted">微信号</view>
      <view class="wechat-id">{{contact.wechat_id}}</view>
      <view class="primary-button" bindtap="copyWechat">复制微信号</view>
    </view>
    <view wx:elif="{{canViewContact && contactLoading}}" class="muted">读取中</view>
    <view wx:elif="{{canViewContact && contactError}}"><view class="muted">{{contactError}}</view><button class="secondary-button" bindtap="loadContact">重试</button></view>
    <view wx:elif="{{canViewContact}}" class="muted">卖家暂未填写微信号</view>
    <view wx:else>
      <view class="muted">登录后查看联系方式</view>
      <view class="primary-button" bindtap="goLogin">{{loginLabel}}</view>
    </view>
  </view>

  <view class="actions">
    <view class="secondary-button" bindtap="reportItem">举报</view>
    <view class="primary-button" bindtap="copyShareText">复制分享文案</view>
  </view>
  </block>
</view>

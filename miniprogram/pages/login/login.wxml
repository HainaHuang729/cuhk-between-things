<view class="page">
  <view class="top-title">{{isCloudMode ? '微信登录' : '模拟登录'}}</view>

  <view class="form">
    <input class="field" value="{{wechatId}}" disabled="{{submitting}}" maxlength="40" bindinput="onWechatInput" placeholder="用于交易联系的微信号" />
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="login">登录</button>
  </view>
</view>

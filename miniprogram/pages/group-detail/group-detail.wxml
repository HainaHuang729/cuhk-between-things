<view class="page">
  <view wx:if="{{error}}" class="muted" bindtap="loadGroup">{{error}}</view>
  <block wx:elif="{{group}}">
    <view class="group-summary">
      <view class="top-title">{{group.title}}</view>
      <view class="badge group-{{group.status}}">{{group.status_label}}</view>
      <view class="group-price">{{group.per_person_price}}<text>元/人</text></view>
      <view class="muted">总价 {{group.total_price}}元 · {{group.source_platform}}</view>
      <view class="group-progress">{{group.current_size}} / {{group.target_size}} 人</view>
      <view class="muted">截止 {{group.deadline_text}}</view>
      <view class="muted">交收 {{group.handover_location}}</view>
      <view class="muted">团长 {{group.owner_name}}</view>
    </view>
    <view class="group-description">{{group.description || '暂无补充说明'}}</view>
    <view class="actions">
      <button wx:if="{{group.is_owner && group.status !== 'cancelled' && group.status !== 'expired'}}" class="secondary-button" bindtap="cancelGroup">取消拼团</button>
      <button wx:elif="{{group.is_joined && !group.is_owner && (group.status === 'recruiting' || group.status === 'formed')}}" class="secondary-button" bindtap="leaveGroup">退出拼团</button>
      <button wx:elif="{{!group.is_joined && group.status === 'recruiting'}}" class="primary-button" bindtap="joinGroup">加入拼团</button>
    </view>
    <view class="group-contact">
      <view class="section-title">联系团长</view>
      <block wx:if="{{contact.wechat_id}}">
        <view class="wechat-id">{{contact.wechat_id}}</view>
        <button class="primary-button" bindtap="copyWechat">复制微信号</button>
      </block>
      <block wx:else>
        <view class="muted">登录后查看联系方式</view>
        <button class="primary-button" bindtap="goLogin">登录</button>
      </block>
    </view>
    <button class="secondary-button" bindtap="copyShareText">复制分享文案</button>
  </block>
</view>

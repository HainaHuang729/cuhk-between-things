.top-title {
  font-size: 36rpx;
  line-height: 1.45;
  overflow-wrap: break-word;
}
.group-summary,
.group-description {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e5e9;
}
.group-description {
  white-space: pre-wrap;
  overflow-wrap: break-word;
  line-height: 1.7;
}
.group-summary .muted {
  margin-top: 12rpx;
  overflow-wrap: break-word;
}
.group-price {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #6f2c91;
}
.group-price text {
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
}
.group-progress {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.group-contact {
  margin: 32rpx 0;
  padding: 24rpx;
  border-left: 6rpx solid #ffcc33;
  background: #fff;
}
.group-contact .section-title {
  margin-top: 0;
}
.wechat-id {
  margin: 20rpx 0;
  color: #6f2c91;
  font-size: 36rpx;
  font-weight: 700;
  word-break: break-all;
}
.group-cancelled,
.group-expired {
  background: #e2e5e9;
  color: #697386;
}
button {
  width: 100%;
  margin: 0;
  padding: 0 16rpx;
  font-size: 28rpx;
}
